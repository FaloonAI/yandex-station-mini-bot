{
  "logo": {
    "type": "file",
    "source": "/data/opt/etc/fastfetch/yandexstation.txt",
    "color": { "1": "1;38;2;122;85;255" },
    "padding": { "top": 1 }
  },
  "display": { "separator": "  " },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "cpu",
    "memory",
    "swap",
    { "type": "disk", "folders": ["/", "/bkupgrade", "/data"], "format": "{1} / {2} ({3})" },
    "localip",
    "break",
    "colors"
  ]
}
